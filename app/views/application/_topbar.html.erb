<%# locals: (active: nil) %>
<header class="topbar">
  <%= link_to root_path, class: "brand" do %>
    <%= render "logo" %>
    <span class="wordmark">Bearly Lifts</span>
  <% end %>

  <nav class="nav">
    <%= link_to root_path, class: ["home", ("active" if active == :home)] do %>
      <%= render "nav_icon", icon: :home %><span>Home</span>
    <% end %>
    <%= link_to edit_plan_path, class: ("active" if active == :plan) do %>
      <%= render "nav_icon", icon: :plan %><span>Plan</span>
    <% end %>
    <%= link_to workouts_path, class: ("active" if active == :history) do %>
      <%= render "nav_icon", icon: :history %><span>History</span>
    <% end %>
    <%= link_to progress_index_path, class: ("active" if active == :progress) do %>
      <%= render "nav_icon", icon: :progress %><span>Progress</span>
    <% end %>
  </nav>
</header>
