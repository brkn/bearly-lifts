<% content_for :title, "Forgot password" %>

<main class="screen">
  <%= render "application/auth_topbar" %>

  <section class="stage">
    <p class="eyebrow"><span class="diamond"></span> Reset password</p>
    <h1>Forgot your<br>password?</h1>
    <p class="lede">Enter the email tied to your account and we'll send a link to set a new one.</p>

    <% if flash[:alert] %>
      <div class="alert" role="alert">
        <span class="dot"></span>
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: passwords_path do |form| %>
      <div class="field">
        <%= form.label :email_address, "Email address" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email_address] %>
      </div>
      <button type="submit" class="submit">Email reset instructions <span class="arrow">→</span></button>
    <% end %>
  </section>

  <footer class="foot">
    <%= link_to new_session_path, class: "link" do %><span class="back">←</span> Back to sign in<% end %>
  </footer>
</main>
