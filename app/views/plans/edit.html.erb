<main class="app">
  <header class="topbar">
    <%= link_to root_path, class: "brand" do %>
      <span class="diamond"></span>
      <span class="wordmark">Bearly Lifts</span>
    <% end %>

    <nav class="nav">
      <a class="active" href="#">Plan</a>
      <%= link_to "History", workouts_path %>
      <%= link_to "Progress", progress_path %>
      <span class="avatar">B</span>
    </nav>
  </header>

  <div class="wiz-head">
    <div>
      <div class="wiz-eyebrow">
        Plan today &middot; <%= Date.current.strftime("%a %b %-d") %>
      </div>

      <h1>Review your plan</h1>
    </div>

    <ol class="steps">
      <li data-n="1" data-done>Muscles</li>
      <li class="sep" aria-hidden="true"></li>
      <li data-n="2" data-done>Exercises</li>
      <li class="sep" aria-hidden="true"></li>
      <li data-n="3" aria-current="step">Review</li>
    </ol>
  </div>

  <%= form_with url: plan_path, method: :patch do %>
    <div class="wiz-body">
      <div class="col">
        <p class="lead">Adjust the targets if needed, then save.</p>

        <% @plan.plan_exercises.each do |plan_exercise| %>
          <div class="review-row">
            <span class="rname"><%= plan_exercise.name %></span>

            <label>
              sets
              <input
                type="number"
                name="<%= plan_exercise.input_name(:target_sets) %>"
                value="<%= plan_exercise.target_sets %>"
                min="1"
                step="1">
            </label>

            <label>
              reps
              <input
                type="number"
                name="<%= plan_exercise.input_name(:target_reps) %>"
                value="<%= plan_exercise.target_reps %>"
                min="1"
                step="1">
            </label>

            <label>
              kg
              <input
                type="number"
                name="<%= plan_exercise.input_name(:target_weight) %>"
                value="<%= plan_exercise.target_weight %>"
                min="0"
                step="2.5">
            </label>
          </div>
        <% end %>
      </div>
    </div>

    <footer class="wiz-footer">
      <%= button_tag "← Back", class: "ghost", type: "button", onclick: "history.back()" %>
      <%= button_tag "Save Plan", class: "primary" %>
    </footer>
  <% end %>
</main>
