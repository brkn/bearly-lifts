<main class="app">
  <%= render "topbar", active: :plan %>

  <div class="wiz-head">
    <div>
      <div class="wiz-eyebrow">Plan today &middot; <%= Date.current.strftime("%a %b %-d") %></div>
      <h1>Pick your muscles</h1>
    </div>
    <ol class="steps">
      <li data-n="1" aria-current="step">Muscles</li>
      <li class="sep" aria-hidden="true"></li>
      <li data-n="2">Exercises</li>
      <li class="sep" aria-hidden="true"></li>
      <li data-n="3">Review</li>
    </ol>
  </div>

  <%= form_with url: exercises_plan_path, method: :get,
                data: { controller: "muscle-picker", action: "submit->muscle-picker#submit" } do %>
    <div class="wiz-body">
      <div class="col">
        <p class="lead">Select the muscles you want to train. Overdue ones are shown first.</p>
        <div class="opts">
          <% @muscles.each do |muscle| %>
            <label class="opt">
              <%= check_box_tag "muscles[]", muscle.slug, muscle.overdue?,
                                data: { muscle_picker_target: "muscle" } %>
              <span class="grow">
                <span class="name"><%= muscle.label %></span>
                <p class="meta">
                  <% if muscle.last_trained_on %>
                    <%= muscle.days_since %>d ago
                  <% else %>
                    never trained
                  <% end %>
                </p>
              </span>
              <span class="tag<%= " hot" if muscle.overdue? %>"><%= muscle.overdue? ? "OVERDUE" : "OK" %></span>
            </label>
          <% end %>
        </div>
      </div>
    </div>

    <footer class="wiz-footer">
      <%= button_tag "Next: Exercises →", class: "primary", name: nil %>
    </footer>
  <% end %>
</main>
