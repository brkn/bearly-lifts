<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <style>
    /* mono / shared atoms */
    .mono { font-family: var(--mono); }
    .eyebrow { font-family: var(--mono); font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--sub); }
    .diamond { width: 8px; height: 8px; background: var(--ember); transform: rotate(45deg); border-radius: 1px; flex-shrink: 0; display: inline-block; }

    /* body */
    .body { flex: 1; padding: 32px 40px 36px; display: flex; flex-direction: column; }
    .greeting { display: flex; align-items: baseline; gap: 14px; margin-bottom: 12px; }
    .greeting h1 { margin: 0; font-size: 30px; font-weight: 700; letter-spacing: -.9px; line-height: 1; }
    .greeting .when { font-family: var(--mono); font-size: 11px; letter-spacing: 1.5px; color: var(--sub); }

    /* show-specific */
    .back { font-family: var(--mono); font-size: 11px; letter-spacing: 1px; color: var(--sub); text-decoration: none; transition: color .12s; display: inline-block; margin-bottom: 18px; }
    .back:hover { color: var(--ink); }
    .stats { font-family: var(--mono); font-size: 12px; letter-spacing: .5px; color: var(--sub); margin: 0 0 10px; }
    .worked { font-size: 15px; font-weight: 500; color: var(--ink); margin: 0 0 24px; }
    .lede { font-size: 14px; color: var(--faint); margin: 0 0 24px; line-height: 1.45; max-width: 520px; }

    .exercises { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 4px 26px; }
    .exercise { display: flex; align-items: baseline; gap: 18px; padding: 16px 0; border-top: 1px solid var(--line); }
    .exercise:first-child { border-top: none; }
    .exercise .idx { font-family: var(--mono); font-size: 11px; color: var(--faint); width: 28px; flex-shrink: 0; }
    .exercise .mid { flex: 1; min-width: 0; }
    .exercise .name { font-size: 16px; font-weight: 600; letter-spacing: -.2px; }
    .exercise .sets { font-family: var(--mono); font-size: 12px; color: var(--sub); margin-top: 5px; }
    .exercise .note { font-size: 13px; color: var(--faint); margin-top: 6px; line-height: 1.4; }
  </style>
<% end %>

<main class="app">
  <header class="topbar">
    <%= link_to root_path , class: "brand" do %>
      <span class="diamond"></span>
      <span class="wordmark">IRON &amp; EMBER</span>
    <% end %>

    <nav class="nav">
      <%= link_to "Today", new_plan_path %>
      <a class="active" href="#">History</a>
      <a href="#">Progress</a>
      <span class="avatar">B</span>
    </nav>
  </header>

  <div class="body">
    <%= link_to "← Sessions", sessions_path, class: "back" %>

    <div class="greeting">
      <h1><%= @session.date.strftime("%A") %></h1>
      <span class="when"><%= @session.date.strftime("%b %-d").upcase %></span>
    </div>

    <p class="stats">
      <%= [
            (@session.duration_minutes && "#{@session.duration_minutes} min"),
            "RPE #{@session.rpe}",
            pluralize(@session.session_exercises.size, "lift"),
          ].compact.join(" · ") %>
    </p>

    <p class="worked"><%= @session.muscles.map(&:name).uniq.sort.join(" · ") %></p>

    <% if @session.notes.present? %>
      <p class="lede"><%= @session.notes %></p>
    <% end %>

    <div class="exercises">
      <% @session.session_exercises.sort_by(&:position).each_with_index do |exercise, i| %>
        <div class="exercise">
          <span class="idx"><%= format("%02d", i + 1) %></span>
          <div class="mid">
            <div class="name"><%= exercise.name %></div>
            <div class="sets"><%= exercise.workout_sets.sort_by(&:created_at).map(&:summary).join(" · ") %> kg</div>
            <% if exercise.notes.present? %>
              <div class="note"><%= exercise.notes %></div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</main>
