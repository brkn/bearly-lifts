<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <style>
    .body { flex: 1; padding: 32px 40px 36px; display: flex; flex-direction: column; gap: 24px; }

    .history-head { display: flex; align-items: baseline; justify-content: space-between; }
    .history-head .left { display: flex; align-items: baseline; gap: 14px; }
    .history-head h1 { margin: 0; font-size: 30px; font-weight: 700; letter-spacing: -.9px; line-height: 1; }
    .history-head .tally { font-family: var(--mono); font-size: 11px; color: var(--faint); }
    .history-head .tally b { color: var(--ink); }

    .card { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 0 26px; }

    .row { display: flex; align-items: center; gap: 16px; padding: 14px 0; border-top: 1px solid var(--line); cursor: pointer; color: inherit; text-decoration: none; transition: padding-left .12s; }
    .card > .row:first-child { border-top: none; }
    .row:hover { padding-left: 10px; }
    .row .date { font-family: var(--mono); font-size: 11px; letter-spacing: .5px; color: var(--faint); width: 50px; flex-shrink: 0; }
    .row .mid { flex: 1; min-width: 0; }
    .row .muscles { font-size: 15px; font-weight: 500; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .row .meta { font-family: var(--mono); font-size: 10.5px; color: var(--sub); margin-top: 4px; }
    .row .chev { font-family: var(--mono); font-size: 15px; color: var(--faint); flex-shrink: 0; transition: color .12s, transform .12s; }
    .row:hover .chev { color: var(--ember); transform: translateX(2px); }

    .card-foot { display: flex; align-items: center; padding: 14px 0; border-top: 1px solid var(--line); }
    .card-foot .stat { font-family: var(--mono); font-size: 10.5px; color: var(--faint); }
    .card-foot .stat b { color: var(--ink); font-weight: 700; }

    .empty { text-align: center; padding: 48px 0; font-family: var(--mono); font-size: 11px; letter-spacing: 1.5px; color: var(--faint); }
  </style>
<% end %>

<main class="app">
  <%= render "topbar", active: :history %>

  <div class="body">
    <div class="history-head">
      <h1>History</h1>
      <span class="tally"><b><%= @total_count %></b> total &middot; <b><%= @month_count %></b> this month</span>
    </div>

    <div class="card">
      <% if @workouts.empty? %>
        <div class="empty">NO WORKOUTS YET</div>
      <% else %>
        <% @workouts.each do |workout| %>
          <%= link_to workout_path(workout), class: "row" do %>
            <span class="date"><%= workout.date.strftime("%b %-d").upcase %></span>
            <div class="mid">
              <div class="muscles"><%= workout.muscles.map(&:name).uniq.sort.join(" · ") %></div>
              <div class="meta"><%= pluralize(workout.workout_exercises.size, "lift") %></div>
            </div>
            <span class="chev">&#x203A;</span>
          <% end %>
        <% end %>

        <div class="card-foot">
          <span class="stat"><b><%= @total_count %></b> workouts logged &middot; <b><%= @month_count %></b> this month</span>
        </div>
      <% end %>
    </div>
  </div>
</main>
